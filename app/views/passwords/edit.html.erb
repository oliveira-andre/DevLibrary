<% content_for :title, "Choose a new password · Dev Library" %>

<header class="auth-card__header">
  <h1 class="auth-card__title">Choose a new password</h1>
  <p class="auth-card__lead">Saving it also unlocks your account if too many sign-in attempts locked it.</p>
</header>

<%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
  <%# Tells password managers which account the new password belongs to; never submitted. %>
  <%= tag.input type: "email", value: @user.email_address, autocomplete: "username", hidden: true, readonly: true %>

  <div class="field">
    <%= form.label :password, "New password", class: "field__label" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72,
          placeholder: "Choose a password", class: "input", "aria-describedby": "password-hint" %>
    <p id="password-hint" class="field__hint">At least 8 characters.</p>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Confirm new password", class: "field__label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          placeholder: "Type it again", class: "input" %>
  </div>

  <%= form.submit "Save new password", class: "button button-primary button-block" %>
<% end %>

<p class="auth-card__switch"><%= link_to "Back to sign in", new_session_path %></p>
