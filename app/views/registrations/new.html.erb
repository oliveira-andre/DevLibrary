<% content_for :title, "Create an account · Dev Library" %>

<header class="auth-card__header">
  <h1 class="auth-card__title">Create your account</h1>
  <p class="auth-card__lead">Your library, your shelves and your last page, on every device.</p>
</header>

<% if @user.errors.any? %>
  <div class="error-summary" role="alert">
    <strong>Please fix the following:</strong>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: registration_path, class: "auth-form" do |form| %>
  <div class="field <%= "field--invalid" if @user.errors[:name].any? %>">
    <%= form.label :name, "Name", class: "field__label" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 100,
          placeholder: "What should we call you?", class: "input", "aria-invalid": @user.errors[:name].any? %>
  </div>

  <div class="field <%= "field--invalid" if @user.errors[:email_address].any? %>">
    <%= form.label :email_address, "Email", class: "field__label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username",
          placeholder: "you@example.com", class: "input", "aria-invalid": @user.errors[:email_address].any? %>
  </div>

  <div class="field <%= "field--invalid" if @user.errors[:password].any? %>">
    <%= form.label :password, "Password", class: "field__label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
          placeholder: "Choose a password", class: "input", "aria-describedby": "password-hint",
          "aria-invalid": @user.errors[:password].any? %>
    <p id="password-hint" class="field__hint">At least 8 characters.</p>
  </div>

  <div class="field <%= "field--invalid" if @user.errors[:password_confirmation].any? %>">
    <%= form.label :password_confirmation, "Confirm password", class: "field__label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
          placeholder: "Type it again", class: "input", "aria-invalid": @user.errors[:password_confirmation].any? %>
  </div>

  <%= form.submit "Create account", class: "button button-green button-block" %>
<% end %>

<p class="auth-card__switch">Already have an account? <%= link_to "Sign in", new_session_path %></p>
